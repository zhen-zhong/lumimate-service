generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MessageRole {
  USER
  ASSISTANT
  TOOL
  SYSTEM
}

enum MessageStatus {
  PENDING
  STREAMING
  COMPLETED
  FAILED
}

enum ScheduledTaskStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum KnowledgeDocumentStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  DELETED
}

enum MemoryCategory {
  PREFERENCE
  RELATIONSHIP
  COMMITMENT
  PLACE
  EVENT
  FACT
}

enum MemoryStatus {
  CANDIDATE
  CONFIRMED
  ARCHIVED
  DELETED
}

enum AgentIntentType {
  REMINDER
  FOLLOW_UP
  PROACTIVE
}

enum AgentIntentStatus {
  AWAITING_CONFIRMATION
  SCHEDULED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

model User {
  id          String         @id @default(cuid())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  conversations Conversation[]
  tasks       ScheduledTask[]
  documents   KnowledgeDocument[]
  memories    Memory[]
  relationships Relationship[]
  intents     AgentIntent[]
  proactivePolicy ProactivePolicy?
}

model Conversation {
  id                  String    @id @default(cuid())
  userId              String
  title               String?
  agentName           String    @default("LumiMate")
  agentProfile        String    @default("") @db.Text
  responseStyle       String    @default("温和、简洁")
  modelId             String    @default("deepseek-flash")
  imageModelId        String    @default("gpt-image-2.5-flare")
  contextMessageLimit Int       @default(100)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages            Message[]
  memories            Memory[]
  relationship        Relationship?
  intents             AgentIntent[]

  @@index([userId, updatedAt])
}

model AiModel {
  id        String   @id
  label     String
  provider  String
  protocol  String
  capability String  @default("chat")
  apiKeyEnv String?
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, sortOrder])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  role           MessageRole
  status         MessageStatus @default(COMPLETED)
  content        String        @db.Text
  metadata       Json?
  modelId        String?
  modelLabel     String?
  provider       String?
  protocol       String?
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime      @default(now())
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Memory {
  id              String         @id @default(cuid())
  userId          String
  conversationId  String?
  category        MemoryCategory
  status          MemoryStatus   @default(CANDIDATE)
  content         String         @db.Text
  normalizedValue String?        @db.Text
  sourceMessageId String?
  confidence      Float          @default(0.5)
  visibility      String         @default("private")
  expiresAt       DateTime?
  confirmedAt     DateTime?
  deletedAt       DateTime?
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation    Conversation?  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, status, updatedAt])
  @@index([conversationId, status])
  @@index([sourceMessageId])
}

model Relationship {
  id                  String       @id @default(cuid())
  userId              String
  conversationId      String       @unique
  preferredName       String?
  relationshipSummary String       @default("") @db.Text
  communicationStyle  String       @default("") @db.Text
  emotionSummary      String       @default("") @db.Text
  lastInteractionAt   DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation        Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model AgentIntent {
  id             String            @id @default(cuid())
  userId         String
  conversationId String?
  type           AgentIntentType
  title          String
  payload        Json?
  timezone       String
  dueAt          DateTime
  status         AgentIntentStatus @default(AWAITING_CONFIRMATION)
  idempotencyKey String            @unique
  sourceMessageId String?
  confirmedAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  cancelledAt    DateTime?
  lastError      String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation?     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, status, dueAt])
  @@index([conversationId, status, dueAt])
}

model ProactivePolicy {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  enabled                Boolean  @default(false)
  quietHoursStart        String?
  quietHoursEnd          String?
  dailyLimit             Int      @default(1)
  minimumIntervalMinutes Int      @default(720)
  lastProactiveAt        DateTime?
  dailyUsageDate         String?
  dailyUsageCount        Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ScheduledTask {
  id          String              @id @default(cuid())
  userId      String
  title       String
  prompt      String              @db.Text
  timezone    String
  runAt       DateTime?
  repeatRule  String?
  status      ScheduledTaskStatus @default(ACTIVE)
  lastRunAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, runAt])
}

model KnowledgeDocument {
  id          String                  @id @default(cuid())
  userId      String
  filename    String
  mimeType    String
  storageKey  String
  status      KnowledgeDocumentStatus @default(UPLOADING)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks      KnowledgeChunk[]

  @@index([userId, status])
}

model KnowledgeChunk {
  id         String            @id @default(cuid())
  documentId String
  ordinal    Int
  content    String            @db.Text
  metadata   Json?
  createdAt  DateTime          @default(now())
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, ordinal])
}
