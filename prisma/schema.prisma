generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MessageRole {
  USER
  ASSISTANT
  TOOL
  SYSTEM
}

enum MessageStatus {
  PENDING
  STREAMING
  COMPLETED
  FAILED
}

enum ScheduledTaskStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum KnowledgeDocumentStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  DELETED
}

model User {
  id          String         @id @default(cuid())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  conversations Conversation[]
  tasks       ScheduledTask[]
  documents   KnowledgeDocument[]
}

model Conversation {
  id                  String    @id @default(cuid())
  userId              String
  title               String?
  agentName           String    @default("LumiMate")
  agentProfile        String    @default("") @db.Text
  responseStyle       String    @default("温和、简洁")
  contextMessageLimit Int       @default(100)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages            Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  role           MessageRole
  status         MessageStatus @default(COMPLETED)
  content        String        @db.Text
  metadata       Json?
  createdAt      DateTime      @default(now())
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model ScheduledTask {
  id          String              @id @default(cuid())
  userId      String
  title       String
  prompt      String              @db.Text
  timezone    String
  runAt       DateTime?
  repeatRule  String?
  status      ScheduledTaskStatus @default(ACTIVE)
  lastRunAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, runAt])
}

model KnowledgeDocument {
  id          String                  @id @default(cuid())
  userId      String
  filename    String
  mimeType    String
  storageKey  String
  status      KnowledgeDocumentStatus @default(UPLOADING)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks      KnowledgeChunk[]

  @@index([userId, status])
}

model KnowledgeChunk {
  id         String            @id @default(cuid())
  documentId String
  ordinal    Int
  content    String            @db.Text
  metadata   Json?
  createdAt  DateTime          @default(now())
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, ordinal])
}
